---
// Shared case-study page shell. Body content goes in the default slot as
// <section class="block"> elements.
import "../styles/global.css";
import { site } from "../data/site";

interface Result {
  value: string;
  label: string;
}

interface Props {
  title: string;
  desc: string;
  label: string;
  heading: string;
  results: Result[];
  stack: string[];
}

const { title, desc, label, heading, results, stack } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: desc,
  url: canonical,
  image: new URL("/og.png", site.url).href,
  author: {
    "@type": "Person",
    name: site.name,
    url: site.url,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#0c0a08" />
    <title>{title} — David R. Lyons</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(articleSchema)}
    />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:image" content={new URL("/og.png", site.url).href} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
  </head>
  <body>
    <main class="cs">
      <div class="container">
        <a href="/#work" class="back">← Back to work</a>

        <header class="cs-head">
          <p class="label">{label}</p>
          <h1>{heading}</h1>
          <p class="lead">{desc}</p>
        </header>

        <ul class="results">
          {
            results.map((r) => (
              <li>
                <span class="r-value">{r.value}</span>
                <span class="r-label">{r.label}</span>
              </li>
            ))
          }
        </ul>

        <slot />

        <section class="block">
          <h2>Stack</h2>
          <ul class="tags">
            {stack.map((t) => <li>{t}</li>)}
          </ul>
        </section>

        <a href="/#contact" class="cta">Let's build something →</a>
      </div>
    </main>

    <style is:global>
      .cs { padding-block: var(--space-12) var(--space-24); }
      .back {
        display: inline-block;
        font-family: var(--font-mono);
        font-size: var(--fs-label);
        letter-spacing: var(--label-spacing);
        text-transform: uppercase;
        color: var(--text-muted);
        margin-bottom: var(--space-12);
      }
      .back:hover { color: var(--accent); }
      .cs-head { max-width: 46rem; }
      .cs-head h1 { margin: var(--space-3) 0; }
      .lead { font-size: var(--fs-lead); color: var(--text-muted); }
      .results {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: var(--space-6);
        margin: var(--space-12) 0;
        padding: var(--space-8) 0;
        border-block: 1px solid var(--border);
      }
      .r-value {
        display: block;
        color: var(--accent);
        font-weight: 700;
        font-size: 1.05rem;
      }
      .r-label {
        display: block;
        margin-top: 2px;
        font-family: var(--font-mono);
        font-size: var(--fs-label);
        letter-spacing: var(--label-spacing);
        text-transform: uppercase;
        color: var(--text-dim);
      }
      .block { max-width: 46rem; margin-bottom: var(--space-12); }
      .block h2 {
        font-size: var(--fs-h3);
        margin-bottom: var(--space-4);
      }
      .block h3 {
        font-size: 1.05rem;
        color: var(--accent);
        margin: var(--space-6) 0 var(--space-2);
      }
      .block p { margin-bottom: var(--space-3); }
      .block ul.plain { margin: var(--space-3) 0 var(--space-3) var(--space-5); }
      .block ul.plain li { list-style: disc; margin-bottom: var(--space-2); }
      .tags { display: flex; flex-wrap: wrap; gap: var(--space-2); }
      .tags li {
        font-family: var(--font-mono);
        font-size: var(--fs-label);
        color: var(--text-muted);
        border: 1px solid var(--border);
        border-radius: 100px;
        padding: 0.3rem 0.7rem;
      }
      .cta {
        display: inline-block;
        margin-top: var(--space-6);
        background: var(--accent);
        color: var(--accent-contrast);
        font-weight: 700;
        font-size: var(--fs-sm);
        padding: 0.7rem 1.2rem;
        border-radius: var(--radius-sm);
      }
      .cta:hover { background: var(--accent-hover); color: var(--accent-contrast); }
      .note {
        max-width: 46rem;
        margin-bottom: var(--space-12);
        font-size: var(--fs-sm);
        color: var(--text-dim);
        border-left: 2px solid var(--border);
        padding-left: var(--space-4);
      }
      @media (max-width: 700px) {
        .results { grid-template-columns: repeat(2, 1fr); gap: var(--space-6) var(--space-4); }
      }
    </style>
  </body>
</html>
